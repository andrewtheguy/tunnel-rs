# tunnel-rs server configuration example
#
# Usage: tunnel-rs server -c server.toml
#        tunnel-rs server --default-config
#
# Mode is inferred from the 'mode' field below.
# CLI arguments take precedence over config file values.
# This file is iroh-only.

# Required: validates config matches CLI command
role = "server"
mode = "iroh"

# NOTE: For iroh mode, do NOT set 'source' here.
# Clients request sources dynamically. Use allowed_sources below to restrict.

[iroh]
# Path to secret key file for persistent identity (required).
# Generate with: tunnel-rs generate-server-key --output server.key
#
# SECURITY: Plaintext 'secret' is not allowed in config files.
# Use 'secret_file' here (recommended). For containers/automation, set TUNNEL_RS_SECRET environment variable instead.
secret_file = "./server.key"

# Custom relay server URL(s) for failover
# If not provided, uses iroh's default public relays
# relay_urls = [
#     "https://relay1.example.com",
#     "https://relay2.example.com",
# ]

# Custom DNS server URL for iroh endpoint discovery (pkarr), or "none" to disable DNS discovery.
# Used with self-hosted iroh-dns-server for fully independent operation.
# This is NOT system DNS routing and does not affect client DNS resolution.
# NOTE: URL must include the /pkarr path
# dns_server = "https://dns.example.com/pkarr"
#
# Set to "none" to disable DNS-based peer discovery entirely.
# When disabled, clients and server must use one of these methods to connect:
#   1. Common relay server - both specify the same relay_urls
#   2. mDNS - automatic discovery on the same local network
# dns_server = "none"

# Maximum concurrent sessions (default: 100)
max_sessions = 100

# ============================================================================
# Authentication (REQUIRED)
# ============================================================================
# Clients must provide one of these tokens to connect.
# Token format: exactly 47 characters (i + 46 Base64URL chars, no padding)
# Generate with: tunnel-rs generate-auth-token
#
# SECURITY: Plaintext 'auth_tokens' is not allowed in config files.
# Use 'auth_tokens_file' here (recommended). For containers/automation, set TUNNEL_RS_AUTH_TOKENS environment variable instead.
# File format: one token per line, # comments allowed.
auth_tokens_file = "/etc/tunnel-rs/auth_tokens.txt"

# ============================================================================
# Allowed source networks that clients can request (CIDR notation)
# Clients MUST specify --source which must match one of these networks
# Separate lists for TCP and UDP protocols
# Supports IPv4 and IPv6 CIDR notation
[iroh.allowed_sources]
tcp = [
    "127.0.0.0/8",      # localhost
    "192.168.0.0/16",   # private network
    "::1/128",          # IPv6 localhost
]
udp = [
    "10.0.0.0/8",       # private network
]

# ============================================================================
# Encrypted Inline Secrets (Optional)
# ============================================================================
# Instead of _file variants, you can encrypt secrets directly in this config
# using age encryption. This is useful for managing multiple configs with a
# single shared private key.
#
# 1. Generate a key: tunnel-rs config-encryption generate-key --output ~/.config/tunnel-rs/age.key
# 2. Encrypt a value: echo -n "token" | tunnel-rs config-encryption encrypt-value --recipient age1...
# 3. Paste the ageenc:... output as a TOML string value.
#
# encryption_key_file is required at runtime to decrypt ageenc: values.
# encryption_recipient is only used by `encrypt-value` to know which public key to encrypt for.
#
# encryption_key_file = "~/.config/tunnel-rs/age.key"
# encryption_recipient = "age1..."
#
# auth_tokens = ["ageenc:YWdlLWVuY3J5cHRpb24ub3Jn..."]

# ============================================================================
# Transport Tuning (Optional)
# ============================================================================
# Fine-tune QUIC transport layer for performance optimization.
# All values have sensible defaults - only configure if needed.

[iroh.transport]
# Congestion controller algorithm (default: cubic)
# - cubic: Loss-based, widely deployed, best for general internet
# - bbr: Model-based, may perform better on high-bandwidth/high-latency links
# - newreno: Classic TCP-like, most conservative
# congestion_controller = "cubic"

# QUIC per-stream receive window in bytes (default: 67108864 = 64MB)
# Controls per-stream flow control. The connection receive window uses iroh's default.
# Valid range: 1024 (1KB) to 67108864 (64MB)
# receive_window = 67108864

# QUIC send window in bytes (default: 67108864 = 64MB)
# Controls how much data can be sent before acknowledgment
# Valid range: 1024 (1KB) to 67108864 (64MB)
# send_window = 67108864

# QUIC ACK-eliciting threshold (default: unset = iroh/quinn default cadence)
# Number of ack-eliciting packets the peer may receive before it must ACK us.
# This requests the peer to delay ACKs of the data WE send, so a large value
# starves our own sender-side congestion control and hurts bulk throughput.
# Leave unset unless you have measured a benefit. 0 = ACK every packet.
# Valid range: 0 to 65535
# ack_eliciting_threshold = 2
