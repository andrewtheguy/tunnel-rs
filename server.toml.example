# tunnel-rs server configuration example
#
# Usage: tunnel-rs server -c server.toml
#        tunnel-rs server --default-config
#
# CLI arguments take precedence over config file values.

# Required: validates config matches CLI command
role = "server"

# NOTE: do NOT set 'source' here. Clients request sources dynamically;
# use allowed_sources below to restrict what they may ask for.

[iroh]
# Path to secret key file for persistent identity (required).
# Generate with: tunnel-rs generate-server-key --output server.key
# The generated file starts with key-type, '# Created:' and '# EndpointId:'
# comments above the key itself; comment lines are ignored when the key is loaded.
#
# SECURITY: Plaintext 'secret' is not allowed in config files.
# Use 'secret_file' here (recommended). For containers/automation, set TUNNEL_RS_SECRET environment variable instead.
secret_file = "./server.key"

# Custom relay server URL(s) for failover
# If not provided, uses iroh's default public relays.
#
# Every relay listed here is probed individually at startup and ALL of them must
# come online, so a dead backup relay fails startup instead of hiding until the
# relay you depend on goes down.
# relay_urls = [
#     "https://relay1.example.com",
#     "https://relay2.example.com",
# ]

# Optional shared bearer token sent to every custom relay above
# (Authorization: Bearer <token> on the relay WebSocket upgrade). Must match the
# relay's access.shared_token and the client's relay_auth_token. Requires
# relay_urls; the default public relays never take a token.
# Prefer TUNNEL_RS_RELAY_AUTH_TOKEN for production deployments.
# relay_auth_token = "shared-relay-secret"

# Custom relays REQUIRE a self-hosted address lookup service (one
# iroh-dns-server behind a secret-gated reverse proxy; see the self-hosting
# guide in iroh-common-architecture). The server publishes its current relay
# there and clients resolve it, which is what lets the server move to another
# relay. Both values go on every server and client; generate the secret with
# `tunnel-rs generate-lookup-secret` (it carries a checksum, so a typo fails
# at startup). Rejected without relay_urls.
# lookup_url = "https://lookup.example.com"
# lookup_secret = "lks1-..."

# Address lookup is NOT independently configurable: it follows the relay mode.
# Default relays use n0's lookup stack (pkarr publishing + DNS); custom relays
# use the service above instead, and nothing goes to n0. mDNS local-network
# discovery stays on unless --relay-only is used.

# Maximum concurrent sessions (default: 100)
max_sessions = 100

# ============================================================================
# Authentication (REQUIRED)
# ============================================================================
# Clients prove possession of an Ed25519 private key after connecting.
# Generate a client key, then derive its authorized-key entry separately:
#   flexaccess-keys generate-auth-key "alice laptop" > client.key
#   flexaccess-keys show-auth-key --private-key-file client.key >> authorized_keys
#
# Add the entry to the authorized_keys_file below (NOT to this config file).
# Blank lines and lines starting with # are ignored.
# File format: ed25519-pub:<unpadded url-safe base64 32-byte public key>[ comment]
# Whitespace separates the key from the comment, which runs to end of line.
# Example: ed25519-pub:1bhGIken5UAXTkC7cABRzM4cE98xZl3tilGyYZsoyP8 alice laptop
authorized_keys_file = "/etc/tunnel-rs/authorized_keys"

# For automation there is also an inline 'authorized_keys' array holding those
# same lines, but like 'secret' it is accepted only from a JSON --config-stdin
# config, never from a config file such as this one.

# ============================================================================
# Allowed source networks that clients can request (CIDR notation)
# Clients MUST specify --source which must match one of these networks
# Separate lists for TCP and UDP protocols
# Supports IPv4 and IPv6 CIDR notation
[iroh.allowed_sources]
tcp = [
    "127.0.0.0/8",      # localhost
    "192.168.0.0/16",   # private network
    "::1/128",          # IPv6 localhost
]
udp = [
    "10.0.0.0/8",       # private network
]

# ============================================================================
# Transport Tuning (Optional)
# ============================================================================
# Fine-tune QUIC transport layer for performance optimization.
# All values have sensible defaults - only configure if needed.

[iroh.transport]
# Congestion controller algorithm (default: cubic)
# - cubic: Loss-based, widely deployed, best for general internet
# - bbr: Model-based, may perform better on high-bandwidth/high-latency links
# - newreno: Classic TCP-like, most conservative
# congestion_controller = "cubic"

# QUIC per-stream receive window in bytes (default: 67108864 = 64MB)
# Controls per-stream flow control. The connection receive window uses iroh's default.
# Valid range: 1024 (1KB) to 67108864 (64MB)
# receive_window = 67108864

# QUIC send window in bytes (default: 67108864 = 64MB)
# Controls how much data can be sent before acknowledgment
# Valid range: 1024 (1KB) to 67108864 (64MB)
# send_window = 67108864

# QUIC ACK-eliciting threshold (default: unset = iroh/quinn default cadence)
# Number of ack-eliciting packets the peer may receive before it must ACK us.
# This requests the peer to delay ACKs of the data WE send, so a large value
# starves our own sender-side congestion control and hurts bulk throughput.
# Leave unset unless you have measured a benefit. 0 = ACK every packet.
# Valid range: 0 to 65535
# ack_eliciting_threshold = 2
